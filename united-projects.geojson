  "indexHtml": "\n<!DOCTYPE html>\n<html>\n<head>\n  <title>United Projects Map</title>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <style>\n    html, body, #map { height: 100%; margin: 0; padding: 0; }\n  </style>\n  <link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" />\n  <script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n</head>\n<body>\n  <div id=\"map\"></div>\n  <script>\n    const map = L.map('map').setView([51.0447, -114.0719], 10);\n    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);\n\n    fetch('united-projects.geojson')\n      .then(response => response.json())\n      .then(data => {\n        const statusColors = {\n          \"Won\": \"green\",\n          \"Lose\": \"red\",\n          \"Estimating\": \"orange\",\n          \"Bid submitted\": \"blue\",\n          \"DP placed\": \"pink\",\n          \"\": \"gray\"\n        };\n\n        L.geoJSON(data, {\n          pointToLayer: function (feature, latlng) {\n            const color = statusColors[feature.properties.Status] || \"black\";\n            return L.circleMarker(latlng, {\n              radius: 6,\n              fillColor: color,\n              color: \"#000\",\n              weight: 1,\n              opacity: 1,\n              fillOpacity: 0.8\n            });\n          },\n          onEachFeature: function (feature, layer) {\n            const p = feature.properties;\n            layer.bindPopup(\n              `<b>${p[\"Project Name\"]}</b><br/>\n               ID: ${p[\"Project ID\"]}<br/>\n               Status: ${p[\"Status\"]}<br/>\n               Description: ${p[\"Description\"]}<br/>\n               Updated: ${p[\"Updated At\"]}`\n            );\n          }\n        }).addTo(map);\n      });\n  </script>\n</body>\n</html>\n"
}

