  "indexHtml": "\n<!DOCTYPE html>\n<html>\n  <head>\n    <title>United Projects Map</title>\n    <meta charset=\"utf-8\" />\n    <style>\n      html, body, #map {\n        height: 100%;\n        margin: 0;\n        padding: 0;\n      }\n    </style>\n    <script src=\"https://maps.googleapis.com/maps/api/js?key=AIzaSyAfX45EKkc_I2jIGHH67iv4H-jOkbgIfNA\"></script>\n  </head>\n  <body>\n    <div id=\"map\"></div>\n    <script>\n      const map = new google.maps.Map(document.getElementById(\"map\"), {\n        zoom: 10,\n        center: { lat: 51.0447, lng: -114.0719 }\n      });\n\n      const geojson = {\n  \"type\": \"FeatureCollection\",\n  \"features\": [\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.45990900\",\n          \"51.16198900\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"F1489\",\n        \"Project Name\": \"greenland\",\n        \"Status\": \"Lose\",\n        \"Description\": \"roofing\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.47219130\",\n          \"51.15890970\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"F1598\",\n        \"Project Name\": \"iceland\",\n        \"Status\": \"Won\",\n        \"Description\": \"gypcrete\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.47534150\",\n          \"51.16045200\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"F1614\",\n        \"Project Name\": \"monowheel\",\n        \"Status\": \"DP placed\",\n        \"Description\": \"cladding\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.04086900\",\n          \"51.02463900\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"F000\",\n        \"Project Name\": \"base\",\n        \"Status\": \"Bid submitted\",\n        \"Description\": \"traffic coating\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.05371600\",\n          \"51.02121260\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"F900\",\n        \"Project Name\": \"Cabin\",\n        \"Status\": \"Won\",\n        \"Description\": \"waterproofing\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.05180480\",\n          \"51.02284000\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"F700\",\n        \"Project Name\": \"Peak\",\n        \"Status\": \"Estimating\",\n        \"Description\": \"service\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.06299900\",\n          \"51.01262800\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"f157\",\n        \"Project Name\": \"Annex Ale Project\",\n        \"Status\": \"Estimating\",\n        \"Description\": \"roofing\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.06299900\",\n          \"51.01262800\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"f434\",\n        \"Project Name\": \"The Establishment Brewing Company\",\n        \"Status\": \"Won\",\n        \"Description\": \"cladding\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.07177740\",\n          \"51.03075090\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"t45\",\n        \"Project Name\": \"South Block Barbecue & Brewing Co.\",\n        \"Status\": \"DP placed\",\n        \"Description\": \"roofing\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.06274400\",\n          \"51.03228500\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"k78\",\n        \"Project Name\": \"greenbowl\",\n        \"Status\": \"Bid submitted\",\n        \"Description\": \"cladding\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.05515720\",\n          \"51.02718090\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"o98\",\n        \"Project Name\": \"earth\",\n        \"Status\": \"Lose\",\n        \"Description\": \"service\",\n        \"Updated At\": \"\"\n      }\n    },\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [\n          \"-114.03997800\",\n          \"50.98948900\"\n        ]\n      },\n      \"properties\": {\n        \"Project ID\": \"y978\",\n        \"Project Name\": \"test1\",\n        \"Status\": \"Estimating\",\n        \"Description\": \"roofing\",\n        \"Updated At\": \"\"\n      }\n    }\n  ]\n};\n\n      geojson.features.forEach(feature => {\n        const coords = feature.geometry.coordinates;\n        const props = feature.properties;\n\n        const marker = new google.maps.Marker({\n          position: {\n            lat: parseFloat(coords[1]),\n            lng: parseFloat(coords[0])\n          },\n          map,\n          title: props[\"Project Name\"]\n        });\n\n        const info = new google.maps.InfoWindow({\n          content: \"<b>\" + props[\"Project Name\"] + \"</b><br>\" +\n                   \"Status: \" + props[\"Status\"] + \"<br>\" +\n                   \"Scope: \" + props[\"Description\"] + \"<br>\" +\n                   \"Updated: \" + props[\"Updated At\"]\n        });\n\n        marker.addListener(\"click\", () => {\n          info.open(map, marker);\n        });\n      });\n    </script>\n  </body>\n</html>\n"
